# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# In development/test mode, an in-memory MongoDB will auto-boot if this is not provided
MONGODB_URI=mongodb://localhost:27017/timbaktu

# Authentication & Security
JWT_SECRET=super_secret_timbaktu_jwt_key_min_32_characters_long_12345
SESSION_SECRET=super_secret_session_key_for_cookies_timbaktu_67890
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Media Storage Configuration
# Options: "local" (default for zero-config dev), "cloudinary", or "s3"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# Cloudinary Configuration (Optional - for production media hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3 Configuration (Optional - if using AWS S3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Frontend Environment Variables (Vite prefixed)
VITE_API_BASE_URL=http://localhost:5000/api/v1
